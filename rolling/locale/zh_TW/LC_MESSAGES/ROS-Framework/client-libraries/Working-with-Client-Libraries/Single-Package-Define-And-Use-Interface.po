msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Single-Package-Define-And-Use-Interface.rst:203
msgid ""
"using namespace std::chrono_literals;\n"
"\n"
"class AddressBookPublisher : public rclcpp::Node\n"
"{\n"
"public:\n"
"  AddressBookPublisher()\n"
"  : Node(\"address_book_publisher\")\n"
"  {\n"
"    address_book_publisher_ =\n"
"      this->create_publisher<more_interfaces::msg::"
"AddressBook>(\"address_book\");"
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Single-Package-Define-And-Use-Interface.rst:216
msgid "Create a callback to publish the messages periodically."
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Single-Package-Define-And-Use-Interface.rst:218
msgid "auto publish_msg = [this]() -> void {"
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Single-Package-Define-And-Use-Interface.rst:222
msgid "Create an ``AddressBook`` message instance that we will later publish."
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Single-Package-Define-And-Use-Interface.rst:224
msgid "auto message = more_interfaces::msg::AddressBook();"
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Single-Package-Define-And-Use-Interface.rst:228
msgid "Populate ``AddressBook`` fields."
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Single-Package-Define-And-Use-Interface.rst:230
msgid ""
"message.first_name = \"John\";\n"
"message.last_name = \"Doe\";\n"
"message.phone_number = \"1234567890\";\n"
"message.phone_type = message.PHONE_TYPE_MOBILE;"
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Single-Package-Define-And-Use-Interface.rst:237
msgid "Finally send the message periodically."
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Single-Package-Define-And-Use-Interface.rst:239
msgid ""
"std::cout << \"Publishing Contact\\nFirst:\" << message.first_name <<\n"
"  \"  Last:\" << message.last_name << std::endl;\n"
"\n"
"this->address_book_publisher_->publish(message);"
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Single-Package-Define-And-Use-Interface.rst:246
msgid ""
"Create a 1 second timer to call our ``publish_msg`` function every second."
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Single-Package-Define-And-Use-Interface.rst:248
msgid "timer_ = this->create_wall_timer(1s, publish_msg);"
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Single-Package-Define-And-Use-Interface.rst:253
msgid "3.2 Build the publisher"
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Single-Package-Define-And-Use-Interface.rst:255

"main',\n"
"        'data_generator_node = bag_recorder_nodes_py.data_generator_node:"
"main',\n"
"        'data_generator_executable = bag_recorder_nodes_py."
"data_generator_executable:main',\n"
"    ],\n"
"},"
msgstr ""


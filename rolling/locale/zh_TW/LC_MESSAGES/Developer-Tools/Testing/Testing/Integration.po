#: ../../../source/Developer-Tools/Testing/Testing/Integration.rst:6
msgid "Writing Basic Integration Tests with launch_testing"
msgstr ""

#: ../../../source/Developer-Tools/Testing/Testing/Integration.rst:8
msgid "**Goal:** Create and run integration tests on the ROS 2 turtlesim node."
msgstr ""

#: ../../../source/Developer-Tools/Testing/Testing/Integration.rst:10
msgid "**Tutorial level:** Intermediate"
msgstr ""

#: ../../../source/Developer-Tools/Testing/Testing/Integration.rst:12

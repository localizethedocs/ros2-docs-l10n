msgstr ""

#: ../../../source/Developer-Tools/Testing/Testing/Integration.rst:16
msgid "Contents"
msgstr ""

#: ../../../source/Developer-Tools/Testing/Testing/Integration.rst:19
msgid "Prerequisites"
msgstr ""

#: ../../../source/Developer-Tools/Testing/Testing/Integration.rst:21
msgid ""
"Before starting this tutorial, it is recommended to have completed the "
"following tutorials on launching nodes:"
msgstr ""

#: ../../../source/Developer-Tools/Testing/Testing/Integration.rst:23
msgid ""
":doc:`Launching Multiple Nodes <../../../ROS-Framework/nodes/Working-with-"
"nodes/Launching-Multiple-Nodes/Launching-Multiple-Nodes>`"
msgstr ""


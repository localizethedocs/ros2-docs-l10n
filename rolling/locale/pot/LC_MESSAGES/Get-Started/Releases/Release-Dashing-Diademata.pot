"\n"
"def describe_parameters(names: List[str]) -> List[ParameterDescriptor]\n"
"\n"
"def set_descriptor(\n"
"    name: str,\n"
"    descriptor: ParameterDescriptor,\n"
"    alternative_value: Optional[ParameterValue] = None\n"
") -> ParameterValue"

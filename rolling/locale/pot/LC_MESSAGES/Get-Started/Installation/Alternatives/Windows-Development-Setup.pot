msgid "how-to"
msgstr ""

#: ../../../source/Get-Started/Installation/Alternatives/Windows-Development-Setup.rst:-1
msgid "expert"
msgstr ""

#: ../../../source/Get-Started/Installation/Alternatives/Windows-Development-Setup.rst:-1

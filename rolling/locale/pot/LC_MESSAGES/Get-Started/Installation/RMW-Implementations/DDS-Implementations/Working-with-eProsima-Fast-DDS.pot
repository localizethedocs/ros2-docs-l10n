msgstr ""

#: ../../../source/Get-Started/Installation/RMW-Implementations/DDS-Implementations/Working-with-eProsima-Fast-DDS.rst:41
msgid "$ sudo apt install ros-rolling-rmw-fastrtps-cpp"
msgstr ""

#: ../../../source/Get-Started/Installation/RMW-Implementations/DDS-Implementations/Working-with-eProsima-Fast-DDS.rst:46
msgid "Build from source code"
msgstr ""

#: ../../../source/Get-Started/Installation/RMW-Implementations/DDS-Implementations/Working-with-eProsima-Fast-DDS.rst:48
msgid "Building from source code is also another way to install."
msgstr ""

#: ../../../source/Get-Started/Installation/RMW-Implementations/DDS-Implementations/Working-with-eProsima-Fast-DDS.rst:50
msgid ""
"First, clone Fast DDS and rmw_fastrtps in the ROS 2 workspace source "
"directory."
msgstr ""

#: ../../../source/Get-Started/Installation/RMW-Implementations/DDS-Implementations/Working-with-eProsima-Fast-DDS.rst:52
msgid ""
"$ cd ros2_ws/src\n"
"$ git clone https://github.com/ros2/rmw_fastrtps ros2/rmw_fastrtps -b "
"rolling\n"
"$ git clone https://github.com/eProsima/Fast-DDS eProsima/fastrtps"
msgstr ""

#: ../../../source/Get-Started/Installation/RMW-Implementations/DDS-Implementations/Working-with-eProsima-Fast-DDS.rst:58
msgid "Then, install necessary packages for Fast DDS."
msgstr ""

#: ../../../source/Get-Started/Installation/RMW-Implementations/DDS-Implementations/Working-with-eProsima-Fast-DDS.rst:60
msgid ""
"$ cd ..\n"
"$ rosdep install --from src -i"
msgstr ""

#: ../../../source/Get-Started/Installation/RMW-Implementations/DDS-Implementations/Working-with-eProsima-Fast-DDS.rst:65
msgid "Finally, run colcon build."
msgstr ""

#: ../../../source/Get-Started/Installation/RMW-Implementations/DDS-Implementations/Working-with-eProsima-Fast-DDS.rst:67
msgid "$ colcon build --symlink-install"
msgstr ""

#: ../../../source/Get-Started/Installation/RMW-Implementations/DDS-Implementations/Working-with-eProsima-Fast-DDS.rst:72
msgid "Switch to rmw_fastrtps"
msgstr ""

#: ../../../source/Get-Started/Installation/RMW-Implementations/DDS-Implementations/Working-with-eProsima-Fast-DDS.rst:74
msgid ""
"The eProsima Fast DDS RMW can be selected by specifying the environment "
"variable:"
msgstr ""

#: ../../../source/Get-Started/Installation/RMW-Implementations/DDS-Implementations/Working-with-eProsima-Fast-DDS.rst:76
msgid "$ export RMW_IMPLEMENTATION=rmw_fastrtps_cpp"
msgstr ""


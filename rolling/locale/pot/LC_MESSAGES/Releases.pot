" .rst-content table.distros:not(.field-list) tr:nth-child(3) td a,\n"
" .rst-content table.distros:not(.field-list) tr:nth-child(3) td a {\n"
"   color: #B0B0B0 !important;\n"
" }\n"
"</style>"

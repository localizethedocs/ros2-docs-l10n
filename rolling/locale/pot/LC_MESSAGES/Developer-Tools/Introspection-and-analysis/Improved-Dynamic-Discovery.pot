#: ../../../source/Developer-Tools/Introspection-and-analysis/Improved-Dynamic-Discovery.rst:246
msgid ""
"For example, the following commands will limit the ROS 2 communication only "
"with localhost and specific peers:"
msgstr ""

#: ../../../source/Developer-Tools/Introspection-and-analysis/Improved-Dynamic-Discovery.rst:250
msgid "Linux"
msgstr ""

#: ../../../source/Developer-Tools/Introspection-and-analysis/Improved-Dynamic-Discovery.rst:252
#: ../../../source/Developer-Tools/Introspection-and-analysis/Improved-Dynamic-Discovery.rst:266
msgid ""
"$ export ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST\n"
"$ export ROS_STATIC_PEERS='192.168.0.1;remote.com'"
msgstr ""

#: ../../../source/Developer-Tools/Introspection-and-analysis/Improved-Dynamic-Discovery.rst:257
#: ../../../source/Developer-Tools/Introspection-and-analysis/Improved-Dynamic-Discovery.rst:271
msgid ""
"To maintain this setting between shell sessions, you can add the command to "
"your shell startup script:"
msgstr ""

#: ../../../source/Developer-Tools/Introspection-and-analysis/Improved-Dynamic-Discovery.rst:259
msgid ""
"$ echo \"export ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST\" >> ~/.bashrc\n"
"$ echo \"export ROS_STATIC_PEERS='192.168.0.1;remote.com'\" >> ~/.bashrc"
msgstr ""

#: ../../../source/Developer-Tools/Introspection-and-analysis/Improved-Dynamic-Discovery.rst:264
msgid "macOS"
msgstr ""

#: ../../../source/Developer-Tools/Introspection-and-analysis/Improved-Dynamic-Discovery.rst:273
msgid ""
"$ echo \"export ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST\" >> ~/."
"bash_profile\n"
"$ echo \"export ROS_STATIC_PEERS='192.168.0.1;remote.com'\" >> ~/."
"bash_profile"
msgstr ""

#: ../../../source/Developer-Tools/Introspection-and-analysis/Improved-Dynamic-Discovery.rst:278
msgid "Windows"
msgstr ""

#: ../../../source/Developer-Tools/Introspection-and-analysis/Improved-Dynamic-Discovery.rst:280
msgid ""
"$ set ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST\n"
"$ set ROS_STATIC_PEERS=192.168.0.1;remote.com"
msgstr ""

#: ../../../source/Developer-Tools/Introspection-and-analysis/Improved-Dynamic-Discovery.rst:285
msgid "If you want to make this permanent between shell sessions, also run:"
msgstr ""

#: ../../../source/Developer-Tools/Introspection-and-analysis/Improved-Dynamic-Discovery.rst:287
msgid ""
"$ setx ROS_AUTOMATIC_DISCOVERY_RANGE LOCALHOST\n"
"$ setx ROS_STATIC_PEERS 192.168.0.1;remote.com"
msgstr ""

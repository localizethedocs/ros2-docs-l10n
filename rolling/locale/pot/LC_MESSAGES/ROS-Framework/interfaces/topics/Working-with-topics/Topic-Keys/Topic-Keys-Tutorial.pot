"/* KeyedSensorDataMsg.idl */\n"
"module demo_keys_cpp {\n"
"  module msg {\n"
"    struct KeyedSensorDataMsg {\n"
"      @key int16 sensor_id;\n"
"      string data;\n"
"    };\n"
"  };\n"
"};"

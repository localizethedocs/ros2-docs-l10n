msgstr ""

#: ../../../source/ROS-Framework/interfaces/services/Working-with-services/Understanding-ROS2-Services/Understanding-ROS2-Services.rst:178
msgid "To inspect a particular service, run:"
msgstr ""

#: ../../../source/ROS-Framework/interfaces/services/Working-with-services/Understanding-ROS2-Services/Understanding-ROS2-Services.rst:180
msgid "$ ros2 service info <service_name>"
msgstr ""

#: ../../../source/ROS-Framework/interfaces/services/Working-with-services/Understanding-ROS2-Services/Understanding-ROS2-Services.rst:184
msgid "For example, to check the ``/clear`` service, run:"
msgstr ""

#: ../../../source/ROS-Framework/interfaces/services/Working-with-services/Understanding-ROS2-Services/Understanding-ROS2-Services.rst:186
msgid "$ ros2 service info /clear"
msgstr ""

#: ../../../source/ROS-Framework/interfaces/services/Working-with-services/Understanding-ROS2-Services/Understanding-ROS2-Services.rst:192
msgid ""
"Type: std_srvs/srv/Empty\n"
"Clients count: 0\n"
"Services count: 1"
msgstr ""

#: ../../../source/ROS-Framework/interfaces/services/Working-with-services/Understanding-ROS2-Services/Understanding-ROS2-Services.rst:198
msgid ""
"To see more detail about the same service, including which node provides it, "
"append the ``--verbose`` (or ``-v``) option:"
msgstr ""

#: ../../../source/ROS-Framework/interfaces/services/Working-with-services/Understanding-ROS2-Services/Understanding-ROS2-Services.rst:200
msgid "$ ros2 service info --verbose <service_name>"
msgstr ""

#: ../../../source/ROS-Framework/interfaces/services/Working-with-services/Understanding-ROS2-Services/Understanding-ROS2-Services.rst:205
msgid ""
"The ``--verbose`` option is available on Lyrical. Older distributions do not "

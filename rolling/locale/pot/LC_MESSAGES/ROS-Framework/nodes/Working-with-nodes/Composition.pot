#: ../../../source/ROS-Framework/nodes/Working-with-nodes/Composition.rst:276
msgid "Remapping container name and namespace"
msgstr ""

#: ../../../source/ROS-Framework/nodes/Working-with-nodes/Composition.rst:278
msgid ""
"The component manager name and namespace can be remapped via standard "
"command line arguments:"

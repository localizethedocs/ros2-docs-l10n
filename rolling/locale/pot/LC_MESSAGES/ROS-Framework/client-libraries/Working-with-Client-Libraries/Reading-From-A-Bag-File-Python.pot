msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Reading-From-A-Bag-File-Python.rst:187
msgid ""
"entry_points={\n"
"    'console_scripts': [\n"
"        'simple_bag_reader = bag_reader_node_py.simple_bag_reader:main',\n"
"    ],\n"
"},"
msgstr ""


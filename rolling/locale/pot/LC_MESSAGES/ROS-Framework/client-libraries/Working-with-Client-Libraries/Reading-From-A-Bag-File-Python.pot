#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Reading-From-A-Bag-File-Python.rst:76
msgid "2 Write the Python Reader"
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Reading-From-A-Bag-File-Python.rst:78
msgid ""
"Inside the ``ros2_ws/src/bag_reader_node_py/bag_reader_node_py`` directory, "
"create a new file called ``simple_bag_reader.py`` and paste the following "
"code into it."
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Reading-From-A-Bag-File-Python.rst:80
msgid ""
"import rclpy\n"
"from rclpy.executors import ExternalShutdownException\n"
"from rclpy.node import Node\n"
"import rosbag2_py\n"
"from std_msgs.msg import String\n"
"\n"
"\n"
"class SimpleBagReader(Node):\n"
"\n"
"    def __init__(self):\n"
"        super().__init__('simple_bag_reader')\n"
"        self.reader = rosbag2_py.SequentialReader()\n"
"        storage_options = rosbag2_py.StorageOptions(\n"
"            uri='my_bag',\n"
"            storage_id='mcap')\n"
"        converter_options = rosbag2_py.ConverterOptions('', '')\n"
"        self.reader.open(storage_options, converter_options)\n"
"\n"
"        self.publisher = self.create_publisher(String, 'chatter', 10)\n"
"        self.timer = self.create_timer(0.1, self.timer_callback)\n"
"\n"
"    def timer_callback(self):\n"
"        while self.reader.has_next():\n"
"            msg = self.reader.read_next()\n"
"            if msg[0] != 'chatter':\n"
"                continue\n"
"            self.publisher.publish(msg[1])\n"
"            self.get_logger().info('Publish serialized data to ' + msg[0])\n"
"            break\n"
"\n"
"\n"
"def main(args=None):\n"
"    try:\n"
"        with rclpy.init(args=args):\n"
"            sbr = SimpleBagReader()\n"
"            rclpy.spin(sbr)\n"
"    except (KeyboardInterrupt, ExternalShutdownException):\n"
"        pass\n"
"\n"
"\n"
"if __name__ == '__main__':\n"
"    main()"
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Reading-From-A-Bag-File-Python.rst:126
msgid "2.1 Examine the code"
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Reading-From-A-Bag-File-Python.rst:128
msgid ""
"The ``import`` statements at the top are the package dependencies. Note the "
"importation of the ``rosbag2_py`` package for the functions and structures "
"necessary to work with bag files."
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Reading-From-A-Bag-File-Python.rst:131
msgid ""
"In the class constructor, we begin by creating the bag reader object that we "
"will use to read from the bag. We are creating a ``SequentialReader``, which "
"reads messages from the bag in the order they are stored. Other readers with "
"different behaviors may be available in `rosbag2_py reader <https://github."
"com/ros2/rosbag2/tree/rolling/rosbag2_py/rosbag2_py/_reader.pyi>`__."
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Reading-From-A-Bag-File-Python.rst:135
msgid "self.reader = rosbag2_py.SequentialReader()"
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Reading-From-A-Bag-File-Python.rst:139
msgid ""
"Now that we have a bag reader object, we can open the bag using it. We "
"specify the URI of the bag and the format (``mcap``), leaving other options "
"at their defaults. The default conversion options are used, which will "
"perform no conversion and store the messages in the serialization format "
"they are received in."
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Reading-From-A-Bag-File-Python.rst:143
msgid ""
"storage_options = rosbag2_py.StorageOptions(\n"
"    uri='my_bag',\n"
"    storage_id='mcap')\n"
"converter_options = rosbag2_py.ConverterOptions('', '')\n"
"self.reader.open(storage_options, converter_options)"
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Reading-From-A-Bag-File-Python.rst:151
msgid ""
"Next, we create a publisher and a timer to publish the data that reader "
"object reads from the bag file."
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Reading-From-A-Bag-File-Python.rst:153
msgid ""
"self.publisher = self.create_publisher(String, 'chatter', 10)\n"
"self.timer = self.create_timer(0.1, self.timer_callback)"
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Reading-From-A-Bag-File-Python.rst:158
msgid ""
"The timer callback publishes all messages from the bag file only to the "
"``chatter`` topic as long as it can read out the data."
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Reading-From-A-Bag-File-Python.rst:160
msgid ""
"def timer_callback(self):\n"
"    while self.reader.has_next():\n"
"        msg = self.reader.read_next()\n"
"        if msg[0] != 'chatter':\n"
"            continue\n"
"        self.publisher.publish(msg[1])\n"
"        self.get_logger().info('Publish serialized data to ' + msg[0])"
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Reading-From-A-Bag-File-Python.rst:170
msgid ""
"Finally, it finishes with the ``main`` function used to create an instance "
"of the node and start ROS processing it."
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Reading-From-A-Bag-File-Python.rst:172
msgid ""
"def main(args=None):\n"
"    try:\n"
"        with rclpy.init(args=args):\n"
"            sbr = SimpleBagReader()\n"
"            rclpy.spin(sbr)\n"
"    except (KeyboardInterrupt, ExternalShutdownException):\n"
"        pass"
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Reading-From-A-Bag-File-Python.rst:183
msgid "2.2 Add executable"
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Reading-From-A-Bag-File-Python.rst:185
msgid ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Writing-A-Simple-Py-Publisher-And-Subscriber.rst:315
msgid "3.1 Examine the code"
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Writing-A-Simple-Py-Publisher-And-Subscriber.rst:317
msgid "Open the ``subscriber_member_function.py`` with your text editor."
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Writing-A-Simple-Py-Publisher-And-Subscriber.rst:319
msgid ""
"import rclpy\n"
"from rclpy.executors import ExternalShutdownException\n"
"from rclpy.node import Node\n"
"\n"
"from std_msgs.msg import String\n"
"\n"
"\n"
"class MinimalSubscriber(Node):\n"
"\n"
"    def __init__(self):\n"
"        super().__init__('minimal_subscriber')\n"
"        self.subscription = self.create_subscription(\n"
"            String,\n"
"            'topic',\n"
"            self.listener_callback,\n"
"            10)\n"
"        self.subscription  # prevent unused variable warning\n"
"\n"
"    def listener_callback(self, msg):\n"
"        self.get_logger().info('I heard: \"%s\"' % msg.data)\n"
"\n"
"\n"
"def main(args=None):\n"
"    try:\n"
"        with rclpy.init(args=args):\n"
"            minimal_subscriber = MinimalSubscriber()\n"
"\n"
"            rclpy.spin(minimal_subscriber)\n"
"    except (KeyboardInterrupt, ExternalShutdownException):\n"
"        pass\n"
"\n"
"\n"
"if __name__ == '__main__':\n"
"    main()"
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Writing-A-Simple-Py-Publisher-And-Subscriber.rst:356
msgid ""
"The subscriber node's code is nearly identical to the publisher's. The "
"constructor creates a subscriber with the same arguments as the publisher "
"using `create_subscription <https://docs.ros.org/en/rolling/p/rclpy/api/node."
"html#rclpy.node.Node.create_subscription>`__. Recall from the :doc:`topics "
"tutorial <../../interfaces/topics/Understanding-ROS2-Topics/Understanding-"
"ROS2-Topics>` that the topic name and message type used by the publisher and "
"subscriber must match to allow them to communicate."
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Writing-A-Simple-Py-Publisher-And-Subscriber.rst:360
msgid ""
"self.subscription = self.create_subscription(\n"
"    String,\n"
"    'topic',\n"
"    self.listener_callback,\n"
"    10)"
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Writing-A-Simple-Py-Publisher-And-Subscriber.rst:368
msgid ""
"The subscriber's constructor and callback don't include any timer "
"definition, because it doesn't need one. Its callback gets called as soon as "
"it receives a message."
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Writing-A-Simple-Py-Publisher-And-Subscriber.rst:371
msgid ""
"The callback definition simply prints an info message to the console, along "
"with the data it received. Recall that the publisher defines ``msg.data = "
"'Hello World: %d' % self.i``"
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Writing-A-Simple-Py-Publisher-And-Subscriber.rst:374
msgid ""
"def listener_callback(self, msg):\n"
"    self.get_logger().info('I heard: \"%s\"' % msg.data)"
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Writing-A-Simple-Py-Publisher-And-Subscriber.rst:379
msgid ""
"The ``main`` definition is almost exactly the same, replacing the creation "
"and spinning of the publisher with the subscriber."
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Writing-A-Simple-Py-Publisher-And-Subscriber.rst:381
msgid ""
"minimal_subscriber = MinimalSubscriber()\n"
"\n"
"rclpy.spin(minimal_subscriber)"
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Writing-A-Simple-Py-Publisher-And-Subscriber.rst:387
msgid ""
"Since this node has the same dependencies as the publisher, there's nothing "
"new to add to ``package.xml``. The ``setup.cfg`` file can also remain "
"untouched."
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Writing-A-Simple-Py-Publisher-And-Subscriber.rst:392
msgid "3.2 Add an entry point"
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Writing-A-Simple-Py-Publisher-And-Subscriber.rst:394
msgid ""
"Reopen ``setup.py`` and add the entry point for the subscriber node below "
"the publisher's entry point. The `entry_points <https://setuptools.pypa.io/"
"en/latest/userguide/entry_point.html>`__ field should now look like this:"
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Writing-A-Simple-Py-Publisher-And-Subscriber.rst:397
msgid ""
"entry_points={\n"
"        'console_scripts': [\n"
"                'talker = py_pubsub.publisher_member_function:main',\n"
"                'listener = py_pubsub.subscriber_member_function:main',\n"
"        ],\n"
"},"
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Writing-A-Simple-Py-Publisher-And-Subscriber.rst:406
msgid ""
"Make sure to save the file, and then your pub/sub system should be ready."

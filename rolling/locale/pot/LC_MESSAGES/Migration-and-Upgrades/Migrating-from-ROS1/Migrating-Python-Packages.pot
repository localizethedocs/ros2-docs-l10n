#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:8
msgid "Migrating Python Packages Reference"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:10
msgid ""
"This page is a reference on how to migrate Python packages from ROS 1 to ROS "
"2. If this is your first time migrating a Python package, then follow :doc:"
"`this guide to migrate an example Python package <Migrating-Python-Package-"
"Example>` first."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:15
msgid "Table of Contents"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:18
msgid "Build tool"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:20
msgid ""
"Instead of using ``catkin_make``, ``catkin_make_isolated`` or ``catkin "
"build`` ROS 2 uses the command line tool `colcon <https://design.ros2.org/"
"articles/build_tool.html>`__ to build and install a set of packages. See "
"the :doc:`beginner tutorial <../../ROS-Framework/client-libraries/Working-"
"with-Client-Libraries/Colcon-Tutorial>` to get started with ``colcon``."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:24
msgid "Build system"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:26
msgid ""
"For pure Python packages, ROS 2 uses the standard ``setup.py`` installation "
"mechanism familiar to Python developers."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:29
msgid "Update the files to use *setup.py*"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:31
msgid ""
"If the ROS 1 package uses CMake only to invoke the ``setup.py`` file and "
"does not contain anything beside Python code (e.g. no messages, services, "
"etc.) it should be converted into a pure Python package in ROS 2:"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:34
msgid "Update or add the build type in the ``package.xml`` file:"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:36
msgid ""
"<export>\n"
"  <build_type>ament_python</build_type>\n"
"</export>"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:43
msgid "Remove the ``CMakeLists.txt`` file"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:46
msgid "Update the ``setup.py`` file to be a standard Python setup script"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:48
msgid ""
"ROS 2 supports Python 3 only. While each package can choose to also support "
"Python 2 it must invoke executables with Python 3 if it uses any API "
"provided by other ROS 2 packages."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:52
msgid "Update source code"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:55
msgid "Node Initialization"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:57
#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:77
#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:104
#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:123
#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:142
#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:157
msgid "In ROS 1:"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:59
msgid ""
"rospy.init_node('asdf')\n"
"\n"
"rospy.loginfo('Created node')"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:65
#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:89
#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:112
#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:131
#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:148
#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:165
msgid "In ROS 2:"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:67
msgid ""
"with rclpy.init(args=sys.argv):\n"
"    node = rclpy.create_node('asdf')\n"
"\n"
"    node.get_logger().info('Created node')"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:75
msgid "ROS Parameters"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:79
msgid ""
" port = rospy.get_param('port', '/dev/ttyUSB0')\n"
" assert isinstance(port, str), 'port parameter must be a str'\n"
"\n"
" baudrate = rospy.get_param('baudrate', 115200)\n"
" assert isinstance(baudrate, int), 'baudrate parameter must be an integer'\n"
"\n"
"rospy.logwarn('port: ' + port)"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:91
msgid ""
"port = node.declare_parameter('port', '/dev/ttyUSB0').value\n"
"assert isinstance(port, str), 'port parameter must be a str'\n"
"\n"
"baudrate = node.declare_parameter('baudrate', 115200).value\n"
"assert isinstance(baudrate, int), 'baudrate parameter must be an integer'\n"
"\n"
"node.get_logger().warn('port: ' + port)"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:102
msgid "Creating a Publisher"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:106
msgid ""
"pub = rospy.Publisher('chatter', String)\n"
"# or\n"
"pub = rospy.Publisher('chatter', String, queue_size=10)"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:114
msgid ""
"pub = node.create_publisher(String, 'chatter', rclpy.qos.QoSProfile())\n"
"# or\n"
"pub = node.create_publisher(String, 'chatter', 10)"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:121
msgid "Creating a Subscriber"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:125
msgid ""
"sub = rospy.Subscriber('chatter', String, callback)\n"
"# or\n"
"sub = rospy.Subscriber('chatter', String, callback, queue_size=10)"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:133
msgid ""
"sub = node.create_subscription(String, 'chatter', callback, rclpy.qos."
"QoSProfile())\n"
"# or\n"
"sub = node.create_subscription(String, 'chatter', callback, 10)"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:140
msgid "Creating a Service"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:144
msgid "srv = rospy.Service('add_two_ints', AddTwoInts, add_two_ints_callback)"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:150
msgid ""
"srv = node.create_service(AddTwoInts, 'add_two_ints', add_two_ints_callback)"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:155
msgid "Creating a Service Client"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:159
msgid ""
"rospy.wait_for_service('add_two_ints')\n"
"add_two_ints = rospy.ServiceProxy('add_two_ints', AddTwoInts)\n"
"resp = add_two_ints(req)"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:167
msgid ""
"add_two_ints = node.create_client(AddTwoInts, 'add_two_ints')\n"
"while not add_two_ints.wait_for_service(timeout_sec=1.0):\n"
"    node.get_logger().info('service not available, waiting again...')\n"
"resp = add_two_ints.call_async(req)\n"
"rclpy.spin_until_future_complete(node, resp)"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Python-Packages.rst:177
msgid ""
"Do not use ``rclpy.spin_until_future_complete`` in a ROS 2 callback. For "
"more details see the :doc:`sync deadlock article <../../ROS-Framework/"
"interfaces/services/Working-with-services/Sync-Vs-Async>`."
msgstr ""

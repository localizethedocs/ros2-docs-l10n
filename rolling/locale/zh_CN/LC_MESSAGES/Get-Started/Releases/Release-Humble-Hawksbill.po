#: ../../../source/Get-Started/Releases/Release-Humble-Hawksbill.rst:614
msgid "**Textures** bring the addition of three new fields to markers:"
msgstr ""

#: ../../../source/Get-Started/Releases/Release-Humble-Hawksbill.rst:616
msgid ""
"# Texture resource is a special URI that can either reference a texture file "
"in\n"
"# a format acceptable to (resource retriever)[https://index.ros.org/p/"
"resource_retriever/]\n"
"# or an embedded texture via a string matching the format:\n"
"#   \"embedded://texture_name\"\n"
"string texture_resource\n"
"# An image to be loaded into the rendering engine as the texture for this "
"marker.\n"
"# This will be used iff texture_resource is set to embedded.\n"
"sensor_msgs/CompressedImage texture\n"
"# Location of each vertex within the texture; in the range: [0.0-1.0]\n"
"UVCoordinate[] uv_coordinates"
msgstr ""

#: ../../../source/Get-Started/Releases/Release-Humble-Hawksbill.rst:629
msgid "RViz will fully support texture rendering through the embedded format."

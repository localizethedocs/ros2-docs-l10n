#: ../../../source/Get-Started/Releases/Release-Humble-Hawksbill.rst:637
msgid ""
"# The filename is used for both debug purposes and to provide a file "
"extension\n"
"# for whatever parser is used.\n"
"string filename\n"
"\n"
"# This stores the raw text of the mesh file.\n"
"uint8[] data"
msgstr ""

#: ../../../source/Get-Started/Releases/Release-Humble-Hawksbill.rst:646

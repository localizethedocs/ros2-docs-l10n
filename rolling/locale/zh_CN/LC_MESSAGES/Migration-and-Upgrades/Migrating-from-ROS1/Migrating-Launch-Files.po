#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:43
#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:184
#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:212
#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:288
msgid "Differences from ROS 1:"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:45
msgid "``type`` attribute is now ``exec``."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:46
msgid "``ns`` attribute is now ``namespace``."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:47
msgid "``required=\"true\"`` is now ``on_exit=\"shutdown\"``."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:48
msgid ""
"The following attributes aren't available: ``machine``, ``respawn_delay``, "
"``clear_params``."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:51
#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:71
#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:150
#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:166
#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:223
#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:264
#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:302
#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:382
msgid "Example"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:53
msgid ""
"<launch>\n"
"   <node pkg=\"demo_nodes_cpp\" exec=\"talker\"/>\n"
"   <node pkg=\"demo_nodes_cpp\" exec=\"listener\"/>\n"
"</launch>"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:61
msgid "param"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:63
msgid "`Available in ROS 1 <https://wiki.ros.org/roslaunch/XML/param>`__."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:64
msgid "Used for passing a parameter to a node."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:65
msgid ""
"There's no global parameter concept in ROS 2. For that reason, it can only "
"be used nested in a ``node`` tag. Some attributes aren't supported in ROS 2: "
"``type``, ``textfile``, ``binfile``, ``executable``."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:68
msgid "The ``command`` attribute is now ``value=\"$(command '...' )\"``."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:73
msgid ""
"<launch>\n"
"   <node pkg=\"demo_nodes_cpp\" exec=\"parameter_event\">\n"
"      <param name=\"foo\" value=\"5\"/>\n"
"   </node>\n"
"</launch>"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:82
#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:441
msgid "Type inference rules"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:84
msgid "Here are some examples of how to write parameters:"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:86
msgid ""
"<node pkg=\"my_package\" exec=\"my_executable\" name=\"my_node\">\n"
"   <!--A string parameter with value \"1\"-->\n"
"   <param name=\"a_string\" value=\"'1'\"/>\n"
"   <!--A integer parameter with value 1-->\n"
"   <param name=\"an_int\" value=\"1\"/>\n"
"   <!--A float parameter with value 1.0-->\n"
"   <param name=\"a_float\" value=\"1.0\"/>\n"
"   <!--A string parameter with value \"asd\"-->\n"
"   <param name=\"another_string\" value=\"asd\"/>\n"
"   <!--Another string parameter, with value \"asd\"-->\n"
"   <param name=\"string_with_same_value_as_above\" value=\"'asd'\"/>\n"
"   <!--Another string parameter, with value \"'asd'\"-->\n"
"   <param name=\"quoted_string\" value=\"\\'asd\\'\"/>\n"
"   <!--A list of strings, with value [\"asd\", \"bsd\", \"csd\"]-->\n"
"   <param name=\"list_of_strings\" value=\"asd, bsd, csd\" value-sep=\", \"/"
">\n"
"   <!--A list of ints, with value [1, 2, 3]-->\n"
"   <param name=\"list_of_ints\" value=\"1,2,3\" value-sep=\",\"/>\n"
"   <!--Another list of strings, with value [\"1\", \"2\", \"3\"]-->\n"
"   <param name=\"another_list_of_strings\" value=\"'1';'2';'3'\" value-"
"sep=\";\"/>\n"
"   <!--A list of strings using an strange separator, with value [\"1\", "
"\"2\", \"3\"]-->\n"
"   <param name=\"strange_separator\" value=\"'1'//'2'//'3'\" value-sep=\"//"
"\"/>\n"
"</node>"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:112
msgid "Parameter grouping"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:114
msgid "In ROS 2, ``param`` tags are allowed to be nested. For example:"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:117
msgid ""
"<node pkg=\"my_package\" exec=\"my_executable\" name=\"my_node\" "
"namespace=\"/an_absoulute_ns\">\n"
"   <param name=\"group1\">\n"
"      <param name=\"group2\">\n"
"         <param name=\"my_param\" value=\"1\"/>\n"
"      </param>\n"
"      <param name=\"another_param\" value=\"2\"/>\n"
"   </param>\n"
"</node>"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:128
msgid "That will create two parameters:"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:130
msgid ""
"A ``group1.group2.my_param`` of value ``1``, hosted by node ``/"
"an_absolute_ns/my_node``."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:131
msgid ""
"A ``group1.another_param`` of value ``2`` hosted by node ``/an_absolute_ns/"
"my_node``."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:133
msgid "It's also possible to use full parameter names:"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:135
msgid ""
"<node pkg=\"my_package\" exec=\"my_executable\" name=\"my_node\" "
"namespace=\"/an_absoulute_ns\">\n"
"   <param name=\"group1.group2.my_param\" value=\"1\"/>\n"
"   <param name=\"group1.another_param\" value=\"2\"/>\n"
"</node>"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:143
msgid "rosparam"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:145
msgid "`Available in ROS 1 <https://wiki.ros.org/roslaunch/XML/rosparam>`__."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:146
msgid "Loads parameters from a yaml file."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:147
msgid "It has been replaced with a ``from`` attribute in ``param`` tags."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:152
msgid ""
"<node pkg=\"my_package\" exec=\"my_executable\" name=\"my_node\" "
"namespace=\"/an_absoulute_ns\">\n"
"   <param from=\"/path/to/file\"/>\n"
"</node>"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:159
msgid "remap"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:161
msgid "`Available in ROS 1 <https://wiki.ros.org/roslaunch/XML/remap>`__."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:162
msgid "Used to pass remapping rules to a node."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:163
msgid "It can only be used within ``node`` tags."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:168
msgid ""
"<launch>\n"
"   <node pkg=\"demo_nodes_cpp\" exec=\"talker\">\n"
"      <remap from=\"chatter\" to=\"my_topic\"/>\n"
"   </node>\n"
"   <node pkg=\"demo_nodes_cpp\" exec=\"listener\">\n"
"      <remap from=\"chatter\" to=\"my_topic\"/>\n"
"   </node>\n"
"</launch>"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:180
msgid "include"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:182
msgid "`Available in ROS 1 <https://wiki.ros.org/roslaunch/XML/include>`__."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:183
msgid "Allows including another launch file."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:186
msgid ""
"Available in ROS 1, included content was scoped. In ROS 2, it's not. This "
"means the values of ``arg`` tags are propagated into included launch files "
"as if ``pass_all_args=\"true\"`` were used in ROS 1. However, this "
"propagation only works for args that have a default value (in the inner/"
"included launch file). Required args have to be passed explicitly. Nest "
"includes in ``group`` tags to scope them (see also ``group`` attributes "
"``scoped`` and ``forwarding`` )."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:192
msgid ""
"``ns`` attribute is not supported. See example of ``push_ros_namespace`` tag "
"for a workaround."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:194
msgid ""
"``arg`` tag nested in an ``include`` tag is now ``let``. However, ``arg`` is "
"still supported for now."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:196
msgid ""
"``let`` tags nested in an ``include`` tag don't support conditionals "
"(``if``, ``unless``) or the ``description`` attribute."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:197
msgid ""
"There is no support for nested ``env`` tags. ``set_env`` and ``unset_env`` "
"can be used instead."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:199
msgid ""
"Both ``clear_params`` and ``pass_all_args`` attributes aren't supported. ROS "
"2 launch behaves as if ``pass_all_args`` were set to true (see above)."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:203
msgid "Examples"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:205
msgid "See `Replacing an include tag`_."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:208
msgid "arg"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:210
msgid "`Available in ROS 1 <https://wiki.ros.org/roslaunch/XML/arg>`__."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:211
msgid ""
"``arg`` is used for declaring a launch argument, or to pass an argument when "
"using ``include`` tags."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:214
msgid "``value`` attribute is not allowed. Use ``let`` tag for this."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:216
msgid "``doc`` is now ``description``."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:217
msgid "When nested within an ``include`` tag:"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:219
msgid "Use ``let`` instead of ``arg``."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:220
msgid "``if``, ``unless``, and ``description`` attributes aren't allowed."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:225
msgid ""
"<launch>\n"
"   <arg name=\"topic_name\" default=\"chatter\"/>\n"
"   <node pkg=\"demo_nodes_cpp\" exec=\"talker\">\n"
"      <remap from=\"chatter\" to=\"$(var topic_name)\"/>\n"
"   </node>\n"
"   <node pkg=\"demo_nodes_cpp\" exec=\"listener\">\n"
"      <remap from=\"chatter\" to=\"$(var topic_name)\"/>\n"
"   </node>\n"
"</launch>"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:238
msgid "Passing an argument to the launch file"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:240
msgid ""
"In the XML launch file above, the ``topic_name`` defaults to the name "
"``chatter``, but can be configured on the command-line. Assuming the above "
"launch configuration is in a file named ``mylaunch.xml``, a different topic "
"name can be used by launching it with the following:"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:243
msgid "$ ros2 launch mylaunch.xml topic_name:=custom_topic_name"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:247
msgid ""
"There is some additional information about passing command-line arguments "
"in :doc:`Using Substitutions <../../Developer-Tools/Launch/Using-"
"Substitutions>`."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:250
msgid "env"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:252
msgid "`Available in ROS 1 <https://wiki.ros.org/roslaunch/XML/env>`__."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:253
msgid "Sets an environment variable."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:254
msgid "It has been replaced with ``env``, ``set_env`` and ``unset_env``:"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:256
msgid ""
"``env`` can only be used nested in a ``node`` or ``executable`` tag. ``if`` "
"and ``unless`` tags aren't supported."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:258
msgid ""
"``set_env`` can be nested within the root tag ``launch`` or in ``group`` "
"tags. It accepts the same attributes as ``env``, and also ``if`` and "
"``unless`` tags."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:260
msgid ""
"``unset_env`` unsets an environment variable. It accepts a ``name`` "
"attribute and conditionals."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:266
msgid ""
"<launch>\n"
"   <set_env name=\"MY_ENV_VAR\" value=\"MY_VALUE\" if=\"CONDITION_A\"/>\n"
"   <set_env name=\"ANOTHER_ENV_VAR\" value=\"ANOTHER_VALUE\" "
"unless=\"CONDITION_B\"/>\n"
"   <set_env name=\"SOME_ENV_VAR\" value=\"SOME_VALUE\"/>\n"
"   <node pkg=\"MY_PACKAGE\" exec=\"MY_EXECUTABLE\" name=\"MY_NODE\">\n"
"      <env name=\"NODE_ENV_VAR\" value=\"SOME_VALUE\"/>\n"
"   </node>\n"
"   <unset_env name=\"MY_ENV_VAR\" if=\"CONDITION_A\"/>\n"
"   <node pkg=\"ANOTHER_PACKAGE\" exec=\"ANOTHER_EXECUTABLE\" "
"name=\"ANOTHER_NODE\"/>\n"
"   <unset_env name=\"ANOTHER_ENV_VAR\" unless=\"CONDITION_B\"/>\n"
"   <unset_env name=\"SOME_ENV_VAR\"/>\n"
"</launch>"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:283
msgid "group"
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:285
msgid "`Available in ROS 1 <https://wiki.ros.org/roslaunch/XML/group>`__."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:286
msgid ""
"Allows limiting the scope of launch configurations. Usually used together "
"with ``let``, ``include`` and ``push_ros_namespace`` tags."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:290
msgid ""
"There is no ``ns`` attribute. See the new ``push_ros_namespace`` tag as a "
"workaround."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:292
msgid "``clear_params`` attribute isn't available."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:293
msgid "It doesn't accept ``remap`` nor ``param`` tags as children."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:294
msgid ""
"It has two new attributes: ``scoped`` and ``forwarding`` (both are true by "
"default). If ``scoped`` is false, the group does not introduce a new "
"variable scope, so actions done to variables inside the group also affect "
"the outside variables. If ``forwarding`` is false, no outside launch "
"configurations ( ``arg`` ) are available inside the group. This can be "
"useful to isolate an included launch file and thus prevent collisions in "
"argument names."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:304
msgid ""
"``launch-prefix`` configuration affects both ``executable`` and ``node`` "
"tags' actions. This example will use ``time`` as a prefix if "
"``use_time_prefix_in_talker`` argument is ``1``, only for the talker."
msgstr ""

#: ../../../source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst:307
msgid ""
"<launch>\n"
"   <arg name=\"use_time_prefix_in_talker\" default=\"0\"/>\n"
"   <group>\n"
"      <let name=\"launch-prefix\" value=\"time\" if=\"$(var "
"use_time_prefix_in_talker)\"/>\n"
"      <node pkg=\"demo_nodes_cpp\" exec=\"talker\"/>\n"
"   </group>\n"
"   <node pkg=\"demo_nodes_cpp\" exec=\"listener\"/>\n"
"</launch>"
msgstr ""


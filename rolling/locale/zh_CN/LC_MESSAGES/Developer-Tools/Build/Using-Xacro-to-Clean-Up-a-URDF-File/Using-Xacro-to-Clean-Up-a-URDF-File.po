msgid ""
"$ ros2 launch urdf_tutorial display.launch.py model:=urdf/08-macroed.urdf."
"xacro"
msgstr ""

#: ../../../source/Developer-Tools/Build/Using-Xacro-to-Clean-Up-a-URDF-File/Using-Xacro-to-Clean-Up-a-URDF-File.rst:244

msgstr ""

#: ../../../source/Developer-Tools/Build/Releasing/_Install-Dependencies.rst:23
msgid "$ pip3 install -U bloom catkin_pkg"
msgstr ""

#: ../../../source/Developer-Tools/Build/Releasing/_Install-Dependencies.rst:27
msgid "Make sure you have rosdep initialized:"
msgstr ""

#: ../../../source/Developer-Tools/Build/Releasing/_Install-Dependencies.rst:29

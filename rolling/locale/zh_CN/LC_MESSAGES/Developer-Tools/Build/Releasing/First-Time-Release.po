#: ../../../source/Developer-Tools/Build/Releasing/First-Time-Release.rst:31
msgid "Install dependencies"
msgstr ""

#: ../../../source/Developer-Tools/Build/Releasing/_Install-Dependencies.rst:5
msgid ""
"Install tools that you will use in the upcoming steps according to your "
"platform:"
msgstr ""


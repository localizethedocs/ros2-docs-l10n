#: ../../../source/Developer-Tools/Launch/Using-Substitutions.rst:462
msgid "Boolean substitutions"
msgstr ""

#: ../../../source/Developer-Tools/Launch/Using-Substitutions.rst:464
msgid ""
"In addition to ``$(eval <python-expression>)``, a set of dedicated boolean "
"substitutions is available for comparing values and combining the results. "
"They can be used anywhere a substitution is allowed, including the ``if`` "
"and ``unless`` attributes of any action."
msgstr ""

#: ../../../source/Developer-Tools/Launch/Using-Substitutions.rst:469
msgid "Comparison is performed on the string representation of each argument."
msgstr ""

#: ../../../source/Developer-Tools/Launch/Using-Substitutions.rst:475
msgid "XML / YAML name"
msgstr ""

#: ../../../source/Developer-Tools/Launch/Using-Substitutions.rst:476
msgid "Python class"
msgstr ""

#: ../../../source/Developer-Tools/Launch/Using-Substitutions.rst:477
msgid "Description"
msgstr ""

#: ../../../source/Developer-Tools/Launch/Using-Substitutions.rst:478
msgid "``$(equals A B)``"
msgstr ""

#: ../../../source/Developer-Tools/Launch/Using-Substitutions.rst:479
msgid "``EqualsSubstitution``"
msgstr ""

#: ../../../source/Developer-Tools/Launch/Using-Substitutions.rst:480
msgid "Resolves to ``'true'`` if ``A`` equals ``B``, otherwise ``'false'``."
msgstr ""

#: ../../../source/Developer-Tools/Launch/Using-Substitutions.rst:481
msgid "``$(not-equals A B)``"
msgstr ""

#: ../../../source/Developer-Tools/Launch/Using-Substitutions.rst:482
msgid "``NotEqualsSubstitution``"
msgstr ""

#: ../../../source/Developer-Tools/Launch/Using-Substitutions.rst:483
msgid ""
"Resolves to ``'true'`` if ``A`` does not equal ``B``, otherwise ``'false'``."
msgstr ""

#: ../../../source/Developer-Tools/Launch/Using-Substitutions.rst:484
msgid "``$(and A B)``"
msgstr ""

#: ../../../source/Developer-Tools/Launch/Using-Substitutions.rst:485
msgid "``AndSubstitution``"
msgstr ""

#: ../../../source/Developer-Tools/Launch/Using-Substitutions.rst:486
msgid "Logical AND of two boolean substitutions."
msgstr ""

#: ../../../source/Developer-Tools/Launch/Using-Substitutions.rst:487
msgid "``$(or A B)``"
msgstr ""

#: ../../../source/Developer-Tools/Launch/Using-Substitutions.rst:488
msgid "``OrSubstitution``"
msgstr ""

#: ../../../source/Developer-Tools/Launch/Using-Substitutions.rst:489
msgid "Logical OR of two boolean substitutions."
msgstr ""

#: ../../../source/Developer-Tools/Launch/Using-Substitutions.rst:490
msgid "``$(any A B ...)``"
msgstr ""

#: ../../../source/Developer-Tools/Launch/Using-Substitutions.rst:491
msgid "``AnySubstitution``"
msgstr ""

#: ../../../source/Developer-Tools/Launch/Using-Substitutions.rst:492
msgid "Resolves to ``'true'`` if any argument is true."
msgstr ""

#: ../../../source/Developer-Tools/Launch/Using-Substitutions.rst:493
msgid "``$(all A B ...)``"
msgstr ""

#: ../../../source/Developer-Tools/Launch/Using-Substitutions.rst:494
msgid "``AllSubstitution``"
msgstr ""

#: ../../../source/Developer-Tools/Launch/Using-Substitutions.rst:495
msgid "Resolves to ``'true'`` only if every argument is true."
msgstr ""

#: ../../../source/Developer-Tools/Launch/Using-Substitutions.rst:497
msgid ""
"The ``if`` predicate from the previous section can also be expressed using "
"boolean substitutions instead of a Python expression:"
msgstr ""

#: ../../../source/Developer-Tools/Launch/Using-Substitutions.rst:503
msgid ""
"<executable cmd=\"ros2 param set /turtlesim background_r $(var "
"new_background_r)\"\n"
"            if=\"$(and $(equals $(var new_background_r) 200) $(var "
"use_provided_red))\"/>"
msgstr ""

#: ../../../source/Developer-Tools/Launch/Using-Substitutions.rst:510
msgid ""
"- executable:\n"
"    cmd: ros2 param set /turtlesim background_r $(var new_background_r)\n"
"    if: $(and $(equals $(var new_background_r) 200) $(var use_provided_red))"
msgstr ""

#: ../../../source/Developer-Tools/Launch/Using-Substitutions.rst:518
msgid ""
"from launch.conditions import IfCondition\n"
"from launch.substitutions import AndSubstitution, EqualsSubstitution, "
"LaunchConfiguration\n"
"\n"
"ExecuteProcess(\n"
"    cmd=[[\n"
"        FindExecutable(name='ros2'),\n"
"        ' param set ',\n"
"        '/turtlesim background_r ',\n"
"        LaunchConfiguration('new_background_r'),\n"
"    ]],\n"
"    condition=IfCondition(\n"
"        AndSubstitution(\n"
"            EqualsSubstitution(LaunchConfiguration('new_background_r'), "
"'200'),\n"
"            LaunchConfiguration('use_provided_red'),\n"
"        )\n"
"    ),\n"
")"
msgstr ""


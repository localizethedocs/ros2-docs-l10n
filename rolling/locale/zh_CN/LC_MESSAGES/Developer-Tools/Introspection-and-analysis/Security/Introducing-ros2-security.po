#: ../../../source/Developer-Tools/Introspection-and-analysis/Security/Introducing-ros2-security.rst:325
msgid ""
"$ export ROS_SECURITY_KEYSTORE=~/sros2_demo/demo_keystore\n"
"$ export ROS_SECURITY_ENABLE=true\n"
"$ export ROS_SECURITY_STRATEGY=Enforce\n"
"$ export ROS_SECURITY_ENCLAVE_OVERRIDE=/talker_listener/listener"
msgstr ""

#: ../../../source/Developer-Tools/Introspection-and-analysis/Security/Introducing-ros2-security.rst:334
msgid ""
"$ set ROS_SECURITY_KEYSTORE=%cd%/demo_keystore\n"
"$ set ROS_SECURITY_ENABLE=true\n"
"$ set ROS_SECURITY_STRATEGY=Enforce\n"
"$ set ROS_SECURITY_ENCLAVE_OVERRIDE=/talker_listener/listener"
msgstr ""

#: ../../../source/Developer-Tools/Introspection-and-analysis/Security/Introducing-ros2-security.rst:342
msgid "Now you can use ``ros2cli`` to communicate with ROS 2 secured network."
msgstr ""

#: ../../../source/Developer-Tools/Introspection-and-analysis/Security/Introducing-ros2-security.rst:344
msgid ""
"$ ros2 node list --no-daemon --spin-time 3\n"
"[INFO] [1733862009.410918416] [rcl]: Found security directory: /root/ros2_ws/"
"colcon_ws/demo_keystore/enclaves/talker_listener/talker\n"
"/listener\n"
"/talker"
msgstr ""

#: ../../../source/Developer-Tools/Introspection-and-analysis/Security/Introducing-ros2-security.rst:351
msgid ""
"$ ros2 topic list --no-daemon --spin-time 3\n"
"[INFO] [1733861998.562163611] [rcl]: Found security directory: /root/ros2_ws/"
"colcon_ws/demo_keystore/enclaves/talker_listener/talker\n"
"/chatter\n"
"/parameter_events\n"
"/rosout"
msgstr ""

#: ../../../source/Developer-Tools/Introspection-and-analysis/Security/Introducing-ros2-security.rst:361
msgid ""
"Avoid using ros2 daemon because it may not have security enclaves, and "

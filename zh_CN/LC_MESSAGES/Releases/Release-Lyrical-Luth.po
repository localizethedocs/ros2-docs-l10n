#: ../../../source/Releases/Release-Lyrical-Luth.rst:79
msgid ""
"Parameter range descriptors check bounds for integer and double arrays "
"(``rclcpp``)"
msgstr ""

#: ../../../source/Releases/Release-Lyrical-Luth.rst:81
msgid ""
"Do your nodes have integer or double arrays? Do you need to constrain the "
"values in those arrays? ``rclcpp`` nodes now validate range constraints on "
"these arrays. Using the code below, the node will only allow setting "
"``my_integer_array`` to a list containing even integers between 2 and 10 "
"(inclusive)."
msgstr ""

#: ../../../source/Releases/Release-Lyrical-Luth.rst:86
msgid ""
"rcl_interfaces::msg::ParameterDescriptor descriptor;\n"
"descriptor.integer_range.resize(1);\n"
"auto & integer_range = descriptor.integer_range.at(0);\n"
"integer_range.from_value = 2;\n"
"integer_range.to_value = 10;\n"
"integer_range.step = 2;\n"
"node->declare_parameter(\"my_integer_array\", std::vector<int64_t>{2, 4, 6, "
"8, 10}, descriptor);"
msgstr ""


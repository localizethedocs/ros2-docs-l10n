#: ../../../source/Releases/Release-Lyrical-Luth.rst:33
msgid "Callback Group Events executor (``rclcpp``)"
msgstr ""

#: ../../../source/Releases/Release-Lyrical-Luth.rst:35
msgid ""
"Looking for better executor performance? Check out the new Callback Group "
"Events Executor. Like its predecessor the ``EventsExecutor``, the "
"``EventsCBGExecutor`` uses an events queue to process ready entities. "
"However, ``EventsCBGExecutor`` adds support for multiple sources of ROS time "
"and multiple threads. Compared to the Single and Multithreaded executors, "
"the ``EventsCBGExecutor`` uses 10% to 15% less CPU."
msgstr ""

#: ../../../source/Releases/Release-Lyrical-Luth.rst:41
msgid "Try it out by instantiating ``rclcpp::executors::EventsCBGExecutor``:"
msgstr ""

#: ../../../source/Releases/Release-Lyrical-Luth.rst:43
msgid ""
"#include <rclcpp/rclcpp.hpp>\n"
"\n"
"// ... class MyNode ...\n"
"\n"
"int main(int argc, char ** argv)\n"
"{\n"
"  rclcpp::init(argc, argv);\n"
"  auto node = std::make_shared<MyNode>();\n"
"  rclcpp::executors::EventsCBGExecutor executor;\n"
"  executor.add_node(node);\n"
"  executor.spin();\n"
"  rclcpp::shutdown();\n"
"  return 0;\n"
"}"
msgstr ""

#: ../../../source/Releases/Release-Lyrical-Luth.rst:60
msgid ""
"Using composable nodes? Launch a component container with the "
"``EventsCBGExecutor`` using the new ``--executor-type`` argument."
msgstr ""

#: ../../../source/Releases/Release-Lyrical-Luth.rst:63
msgid ""
"ros2 run rclcpp_components component_container --executor-type events-cbg"
msgstr ""

#: ../../../source/Releases/Release-Lyrical-Luth.rst:67
msgid ""
"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
"<launch>\n"
"  <node_container pkg=\"rclcpp_components\" exec=\"component_container\" "
"name=\"my_node_container\" namespace=\"\" args=\"--executor-type events-"
"cbg\">\n"
"    <!-- Your composable nodes here -->\n"
"  </node_container>\n"
"</launch>"
msgstr ""


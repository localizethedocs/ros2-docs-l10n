#: ../../../source/ROS-Framework/interfaces/actions/Working-with-actions/Writing-an-Action-Server-Client/Py.rst:262
msgid ""
"So we can send a goal, but how do we know when it is completed? We can get "
"the result information with a couple steps. First, we need to get a goal "
"handle for the goal we sent. Then, we can use the goal handle to request the "
"result."
msgstr ""

#: ../../../source/ROS-Framework/interfaces/actions/Working-with-actions/Writing-an-Action-Server-Client/Py.rst:267
#: ../../../source/ROS-Framework/interfaces/actions/Working-with-actions/Writing-an-Action-Server-Client/Py.rst:332
msgid "Here's the complete code for this example:"
msgstr ""

#: ../../../source/ROS-Framework/interfaces/actions/Working-with-actions/Writing-an-Action-Server-Client/Py.rst:269
msgid ""
"import rclpy\n"
"from rclpy.action import ActionClient\n"
"from rclpy.executors import ExternalShutdownException\n"
"from rclpy.node import Node\n"
"\n"
"from custom_action_interfaces.action import Fibonacci\n"
"\n"
"\n"
"class FibonacciActionClient(Node):\n"
"\n"
"    def __init__(self):\n"
"        super().__init__('fibonacci_action_client')\n"
"        self._action_client = ActionClient(self, Fibonacci, 'fibonacci')\n"
"\n"
"    def send_goal(self, order):\n"
"        goal_msg = Fibonacci.Goal()\n"
"        goal_msg.order = order\n"
"\n"
"        self._action_client.wait_for_server()\n"
"\n"
"        self._send_goal_future = self._action_client."
"send_goal_async(goal_msg)\n"
"\n"
"        self._send_goal_future.add_done_callback(self."
"goal_response_callback)\n"
"\n"
"    def goal_response_callback(self, future):\n"
"        goal_handle = future.result()\n"
"        if not goal_handle.accepted:\n"
"            self.get_logger().info('Goal rejected :(')\n"
"            return\n"
"\n"
"        self.get_logger().info('Goal accepted :)')\n"
"\n"
"        self._get_result_future = goal_handle.get_result_async()\n"
"        self._get_result_future.add_done_callback(self.get_result_callback)\n"
"\n"
"    def get_result_callback(self, future):\n"
"        result = future.result().result\n"
"        self.get_logger().info('Result: {0}'.format(result.sequence))\n"
"        rclpy.shutdown()\n"
"\n"
"\n"
"def main(args=None):\n"
"    try:\n"
"        with rclpy.init(args=args):\n"
"            action_client = FibonacciActionClient()\n"
"\n"
"            action_client.send_goal(10)\n"
"\n"
"            rclpy.spin(action_client)\n"
"    except (KeyboardInterrupt, ExternalShutdownException):\n"
"        pass\n"
"\n"
"\n"
"if __name__ == '__main__':\n"
"    main()\n"
msgstr ""

#: ../../../source/ROS-Framework/interfaces/actions/Working-with-actions/Writing-an-Action-Server-Client/Py.rst:272
msgid ""
"The ``ActionClient.send_goal_async()`` method returns a future to a goal "
"handle. First we register a callback for when the future is complete:"
msgstr ""

#: ../../../source/ROS-Framework/interfaces/actions/Working-with-actions/Writing-an-Action-Server-Client/Py.rst:275
msgid ""
"        self._send_goal_future.add_done_callback(self."
"goal_response_callback)\n"
msgstr ""

#: ../../../source/ROS-Framework/interfaces/actions/Working-with-actions/Writing-an-Action-Server-Client/Py.rst:279
msgid ""
"Note that the future is completed when an action server accepts or rejects "
"the goal request. Let's look at the ``goal_response_callback`` in more "
"detail. We can check to see if the goal was rejected and return early since "
"we know there will be no result:"
msgstr ""

#: ../../../source/ROS-Framework/interfaces/actions/Working-with-actions/Writing-an-Action-Server-Client/Py.rst:283
msgid ""
"    def goal_response_callback(self, future):\n"
"        goal_handle = future.result()\n"
"        if not goal_handle.accepted:\n"
"            self.get_logger().info('Goal rejected :(')\n"
"            return\n"
"\n"
"        self.get_logger().info('Goal accepted :)')\n"
msgstr ""

#: ../../../source/ROS-Framework/interfaces/actions/Working-with-actions/Writing-an-Action-Server-Client/Py.rst:287
msgid ""
"Now that we've got a goal handle, we can use it to request the result with "
"the method ``get_result_async()``. Similar to sending the goal, we will get "
"a future that will complete when the result is ready. Let's register a "
"callback just like we did for the goal response:"
msgstr ""

#: ../../../source/ROS-Framework/interfaces/actions/Working-with-actions/Writing-an-Action-Server-Client/Py.rst:291
msgid ""
"        self._get_result_future = goal_handle.get_result_async()\n"
"        self._get_result_future.add_done_callback(self.get_result_callback)\n"
msgstr ""

#: ../../../source/ROS-Framework/interfaces/actions/Working-with-actions/Writing-an-Action-Server-Client/Py.rst:295
msgid ""
"In the callback, we log the result sequence and shutdown ROS 2 for a clean "
"exit:"
msgstr ""

#: ../../../source/ROS-Framework/interfaces/actions/Working-with-actions/Writing-an-Action-Server-Client/Py.rst:297
msgid ""
"    def get_result_callback(self, future):\n"
"        result = future.result().result\n"
"        self.get_logger().info('Result: {0}'.format(result.sequence))\n"
"        rclpy.shutdown()\n"
msgstr ""

#: ../../../source/ROS-Framework/interfaces/actions/Working-with-actions/Writing-an-Action-Server-Client/Py.rst:301
msgid ""
"With an action server running in a separate terminal, go ahead and try "
"running our Fibonacci action client!"
msgstr ""

#: ../../../source/ROS-Framework/interfaces/actions/Working-with-actions/Writing-an-Action-Server-Client/Py.rst:323
msgid ""
"You should see logged messages for the goal being accepted and the final "
"result."
msgstr ""

#: ../../../source/ROS-Framework/interfaces/actions/Working-with-actions/Writing-an-Action-Server-Client/Py.rst:326
msgid "2.2 Getting feedback"
msgstr ""

#: ../../../source/ROS-Framework/interfaces/actions/Working-with-actions/Writing-an-Action-Server-Client/Py.rst:328
msgid ""
"Our action client can send goals. Nice! But it would be great if we could "
"get some feedback about the goals we send from the action server."
msgstr ""

#: ../../../source/ROS-Framework/interfaces/actions/Working-with-actions/Writing-an-Action-Server-Client/Py.rst:334
msgid ""
"import rclpy\n"
"from rclpy.action import ActionClient\n"
"from rclpy.executors import ExternalShutdownException\n"
"from rclpy.node import Node\n"
"\n"
"from custom_action_interfaces.action import Fibonacci\n"
"\n"
"\n"
"class FibonacciActionClient(Node):\n"
"\n"
"    def __init__(self):\n"
"        super().__init__('fibonacci_action_client')\n"
"        self._action_client = ActionClient(self, Fibonacci, 'fibonacci')\n"
"\n"
"    def send_goal(self, order):\n"
"        goal_msg = Fibonacci.Goal()\n"
"        goal_msg.order = order\n"
"\n"
"        self._action_client.wait_for_server()\n"
"\n"
"        self._send_goal_future = self._action_client."
"send_goal_async(goal_msg, feedback_callback=self.feedback_callback)\n"
"\n"
"        self._send_goal_future.add_done_callback(self."
"goal_response_callback)\n"
"\n"
"    def goal_response_callback(self, future):\n"
"        goal_handle = future.result()\n"
"        if not goal_handle.accepted:\n"
"            self.get_logger().info('Goal rejected :(')\n"
"            return\n"
"\n"
"        self.get_logger().info('Goal accepted :)')\n"
"\n"
"        self._get_result_future = goal_handle.get_result_async()\n"
"        self._get_result_future.add_done_callback(self.get_result_callback)\n"
"\n"
"    def get_result_callback(self, future):\n"
"        result = future.result().result\n"
"        self.get_logger().info('Result: {0}'.format(result.sequence))\n"
"        rclpy.shutdown()\n"
"\n"
"    def feedback_callback(self, feedback_msg):\n"
"        feedback = feedback_msg.feedback\n"
"        self.get_logger().info('Received feedback: {0}'.format(feedback."
"sequence))\n"
"\n"
"\n"
"def main(args=None):\n"
"    try:\n"
"        with rclpy.init(args=args):\n"
"            action_client = FibonacciActionClient()\n"
"\n"
"            action_client.send_goal(10)\n"
"\n"
"            rclpy.spin(action_client)\n"
"    except (KeyboardInterrupt, ExternalShutdownException):\n"
"        pass\n"
"\n"
"\n"
"if __name__ == '__main__':\n"
"    main()\n"
msgstr ""

#: ../../../source/ROS-Framework/interfaces/actions/Working-with-actions/Writing-an-Action-Server-Client/Py.rst:337
msgid "Here's the callback function for feedback messages:"
msgstr ""

#: ../../../source/ROS-Framework/interfaces/actions/Working-with-actions/Writing-an-Action-Server-Client/Py.rst:339
msgid ""
"    def feedback_callback(self, feedback_msg):\n"
"        feedback = feedback_msg.feedback\n"
"        self.get_logger().info('Received feedback: {0}'.format(feedback."
"sequence))\n"
msgstr ""

#: ../../../source/ROS-Framework/interfaces/actions/Working-with-actions/Writing-an-Action-Server-Client/Py.rst:343
msgid ""
"In the callback we get the feedback portion of the message and print the "
"``sequence`` field to the screen."
msgstr ""

#: ../../../source/ROS-Framework/interfaces/actions/Working-with-actions/Writing-an-Action-Server-Client/Py.rst:345
msgid ""
"We need to register the callback with the action client. This is achieved by "
"additionally passing the callback to the action client when we send a goal:"
msgstr ""

#: ../../../source/ROS-Framework/interfaces/actions/Working-with-actions/Writing-an-Action-Server-Client/Py.rst:348
msgid ""
"        self._send_goal_future = self._action_client."
"send_goal_async(goal_msg, feedback_callback=self.feedback_callback)\n"
msgstr ""

#: ../../../source/ROS-Framework/interfaces/actions/Working-with-actions/Writing-an-Action-Server-Client/Py.rst:352
msgid ""
"We're all set. If we run our action client, you should see feedback being "
"printed to the screen."
msgstr ""


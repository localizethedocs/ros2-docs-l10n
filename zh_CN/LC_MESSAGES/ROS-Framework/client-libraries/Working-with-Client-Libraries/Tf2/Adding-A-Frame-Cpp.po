"      file: \"$(find-pkg-share learning_tf2_cpp)/launch/"
"turtle_tf2_demo_launch.py\"\n"
"      let:\n"
"      - name: \"target_frame\"\n"
"        value: \"carrot1\"\n"
"  - node:\n"
"      pkg: \"learning_tf2_cpp\"\n"
"      exec: \"dynamic_frame_tf2_broadcaster\"\n"
"      name: \"dynamic_broadcaster\"\n"
"\n"
msgstr ""


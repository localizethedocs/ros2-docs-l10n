#: ../../../source/ROS-Framework/parameters/Working-with-parameters/Monitoring-For-Parameter-Changes-Python.rst:70
msgid "2 Write the Python node"
msgstr ""

#: ../../../source/ROS-Framework/parameters/Working-with-parameters/Monitoring-For-Parameter-Changes-Python.rst:72
msgid ""
"Inside the ``ros2_ws/src/python_parameter_event_handler/"
"python_parameter_event_handler`` directory, create a new file called "
"``parameter_event_handler.py`` and paste the following code within:"
msgstr ""

#: ../../../source/ROS-Framework/parameters/Working-with-parameters/Monitoring-For-Parameter-Changes-Python.rst:74
msgid ""
"import rclpy\n"
"from rclpy.executors import ExternalShutdownException\n"
"from rclpy.node import Node\n"
"import rclpy.parameter\n"
"\n"
"from rclpy.parameter_event_handler import ParameterEventHandler\n"
"\n"
"\n"
"class SampleNodeWithParameters(Node):\n"
"    def __init__(self):\n"
"        super().__init__('node_with_parameters')\n"
"\n"
"        self.declare_parameter('an_int_param', 0)\n"
"\n"
"        self.handler = ParameterEventHandler(self)\n"
"\n"
"        self.callback_handle = self.handler.add_parameter_callback(\n"
"            parameter_name=\"an_int_param\",\n"
"            node_name=\"node_with_parameters\",\n"
"            callback=self.callback,\n"
"        )\n"
"\n"
"    def callback(self, p: rclpy.parameter.Parameter) -> None:\n"
"        self.get_logger().info(f\"Received an update to parameter: {p.name}: "
"{rclpy.parameter.parameter_value_to_python(p.value)}\")\n"
"\n"
"\n"
"def main():\n"
"    try:\n"
"        with rclpy.init():\n"
"            node = SampleNodeWithParameters()\n"
"            rclpy.spin(node)\n"
"    except (KeyboardInterrupt, ExternalShutdownException):\n"
"        pass"
msgstr ""

#: ../../../source/ROS-Framework/parameters/Working-with-parameters/Monitoring-For-Parameter-Changes-Python.rst:111
msgid "2.1 Examine the code"
msgstr ""

#: ../../../source/ROS-Framework/parameters/Working-with-parameters/Monitoring-For-Parameter-Changes-Python.rst:113
msgid ""
"The ``import`` statements at the top are used to import the package "
"dependencies."
msgstr ""

#: ../../../source/ROS-Framework/parameters/Working-with-parameters/Monitoring-For-Parameter-Changes-Python.rst:115
msgid ""
"import rclpy\n"
"from rclpy.executors import ExternalShutdownException\n"
"from rclpy.node import Node\n"
"import rclpy.parameter\n"
"\n"
"from rclpy.parameter_event_handler import ParameterEventHandler"
msgstr ""

#: ../../../source/ROS-Framework/parameters/Working-with-parameters/Monitoring-For-Parameter-Changes-Python.rst:124
msgid ""
"The next piece of code creates the class ``SampleNodeWithParameters`` and "
"the constructor. The constructor for the class declares an integer parameter "
"``an_int_param``,  with a default value of 0. Next, the code creates a "
"``ParameterEventHandler`` that will be used to monitor changes to parameters."
msgstr ""

#: ../../../source/ROS-Framework/parameters/Working-with-parameters/Monitoring-For-Parameter-Changes-Python.rst:128
msgid ""
"class SampleNodeWithParameters(Node):\n"
"    def __init__(self):\n"
"        super().__init__('node_with_parameters')\n"
"\n"
"        self.declare_parameter('an_int_param', 0)\n"
"\n"
"        self.handler = ParameterEventHandler(self)"
msgstr ""

#: ../../../source/ROS-Framework/parameters/Working-with-parameters/Monitoring-For-Parameter-Changes-Python.rst:139
msgid ""
"Finally, we add a parameter callback and get a callback handler for the new "
"callback."
msgstr ""

#: ../../../source/ROS-Framework/parameters/Working-with-parameters/Monitoring-For-Parameter-Changes-Python.rst:143
msgid ""
"It is very important to save the handle that is returned by "
"``add_parameter_callback``; otherwise, the callback will not be properly "
"registered."
msgstr ""

#: ../../../source/ROS-Framework/parameters/Working-with-parameters/Monitoring-For-Parameter-Changes-Python.rst:145
msgid ""
"self.callback_handle = self.handler.add_parameter_callback(\n"
"    parameter_name=\"an_int_param\",\n"
"    node_name=\"node_with_parameters\",\n"
"    callback=self.callback,\n"
")"
msgstr ""

#: ../../../source/ROS-Framework/parameters/Working-with-parameters/Monitoring-For-Parameter-Changes-Python.rst:153
msgid ""
"For the callback function, we use the ``callback`` method of the "
"``SampleNodeWithParameters`` class."
msgstr ""

#: ../../../source/ROS-Framework/parameters/Working-with-parameters/Monitoring-For-Parameter-Changes-Python.rst:155
msgid ""
"def callback(self, p: rclpy.parameter.Parameter) -> None:\n"
"    self.get_logger().info(f\"Received an update to parameter: {p.name}: "
"{rclpy.parameter.parameter_value_to_python(p.value)}\")"
msgstr ""

#: ../../../source/ROS-Framework/parameters/Working-with-parameters/Monitoring-For-Parameter-Changes-Python.rst:161
msgid ""
"Following the ``SampleNodeWithParameters`` is a typical ``main`` function "
"which initializes ROS, spins the sample node so that it can send and receive "
"messages, and then shuts down after the user enters ^C at the console."
msgstr ""

#: ../../../source/ROS-Framework/parameters/Working-with-parameters/Monitoring-For-Parameter-Changes-Python.rst:163
msgid ""
"def main():\n"
"    try:\n"
"        with rclpy.init():\n"
"            node = SampleNodeWithParameters()\n"
"            rclpy.spin(node)\n"
"    except (KeyboardInterrupt, ExternalShutdownException):\n"
"        pass"
msgstr ""


msgid "Custom ``allocate`` and ``deallocate`` functions."
msgstr ""

#: ../../../source/ROS-Framework/client-libraries/Working-with-Client-Libraries/Allocator-Template-Tutorial.rst:50
msgid "Global ``new`` and ``delete`` operators."
msgstr ""


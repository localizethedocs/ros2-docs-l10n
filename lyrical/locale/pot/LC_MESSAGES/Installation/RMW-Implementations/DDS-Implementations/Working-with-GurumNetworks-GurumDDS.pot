#: ../../../source/Installation/RMW-Implementations/DDS-Implementations/Working-with-GurumNetworks-GurumDDS.rst:36
msgid "Installation"
msgstr ""

#: ../../../source/Installation/RMW-Implementations/DDS-Implementations/Working-with-GurumNetworks-GurumDDS.rst:38
msgid "Option 1: Install from the ROS 2 apt repository (Recommended)"
msgstr ""

#: ../../../source/Installation/RMW-Implementations/DDS-Implementations/Working-with-GurumNetworks-GurumDDS.rst:40
msgid "$ sudo apt install ros-rolling-rmw-gurumdds-cpp"
msgstr ""

#: ../../../source/Installation/RMW-Implementations/DDS-Implementations/Working-with-GurumNetworks-GurumDDS.rst:44
msgid "This installs both ``rmw_gurumdds_cpp`` and ``gurumdds``."
msgstr ""

#: ../../../source/Installation/RMW-Implementations/DDS-Implementations/Working-with-GurumNetworks-GurumDDS.rst:47
msgid "Option 2: Build from source code"
msgstr ""

#: ../../../source/Installation/RMW-Implementations/DDS-Implementations/Working-with-GurumNetworks-GurumDDS.rst:48
msgid "Clone the repository"
msgstr ""

#: ../../../source/Installation/RMW-Implementations/DDS-Implementations/Working-with-GurumNetworks-GurumDDS.rst:50
msgid ""
"$ cd ros2_ws/src\n"
"$ git clone https://github.com/ros2/rmw_gurumdds -b rolling ros2/rmw_gurumdds"
msgstr ""

#: ../../../source/Installation/RMW-Implementations/DDS-Implementations/Working-with-GurumNetworks-GurumDDS.rst:55
msgid "Install dependencies:"
msgstr ""

#: ../../../source/Installation/RMW-Implementations/DDS-Implementations/Working-with-GurumNetworks-GurumDDS.rst:57
msgid ""
"$ cd ..\n"
"$ rosdep install --from src -i --rosdistro rolling"
msgstr ""

#: ../../../source/Installation/RMW-Implementations/DDS-Implementations/Working-with-GurumNetworks-GurumDDS.rst:62
msgid "Build the workspace using Colcon:"
msgstr ""

#: ../../../source/Installation/RMW-Implementations/DDS-Implementations/Working-with-GurumNetworks-GurumDDS.rst:64
msgid "$ colcon build --symlink-install"
msgstr ""

#: ../../../source/Installation/RMW-Implementations/DDS-Implementations/Working-with-GurumNetworks-GurumDDS.rst:70
msgid "Switch to rmw_gurumdds"
msgstr ""

#: ../../../source/Installation/RMW-Implementations/DDS-Implementations/Working-with-GurumNetworks-GurumDDS.rst:71
msgid ""
"Switch from other RMW implementations to rmw_gurumdds by setting the "
"environment variable:"
msgstr ""

#: ../../../source/Installation/RMW-Implementations/DDS-Implementations/Working-with-GurumNetworks-GurumDDS.rst:73
msgid "$ export RMW_IMPLEMENTATION=rmw_gurumdds_cpp"
msgstr ""


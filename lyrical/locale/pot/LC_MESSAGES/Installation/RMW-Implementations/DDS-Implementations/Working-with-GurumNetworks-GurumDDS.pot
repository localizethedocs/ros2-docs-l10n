#: ../../../source/Installation/RMW-Implementations/DDS-Implementations/Working-with-GurumNetworks-GurumDDS.rst:83
msgid ""
"$ source /opt/ros/rolling/setup.bash\n"
"$ ros2 run demo_nodes_cpp talker"
msgstr ""

#: ../../../source/Installation/RMW-Implementations/DDS-Implementations/Working-with-GurumNetworks-GurumDDS.rst:88
msgid ""
"$ source /opt/ros/rolling/setup.bash\n"
"$ ros2 run demo_nodes_cpp listener"
msgstr ""


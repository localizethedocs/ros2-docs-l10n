#: ../../../source/Tutorials/Intermediate/Tf2/Writing-A-Tf2-Listener-Cpp.rst:313
msgid ""
"%YAML 1.2\n"
"---\n"
"launch:\n"
"  - node:\n"
"      pkg: \"turtlesim\"\n"
"      exec: \"turtlesim_node\"\n"
"      name: \"sim\"\n"
"  - node:\n"
"      pkg: \"learning_tf2_cpp\"\n"
"      exec: \"turtle_tf2_broadcaster\"\n"
"      name: \"broadcaster1\"\n"
"      param:\n"
"      - name: \"turtlename\"\n"
"        value: \"turtle1\"\n"
"  - arg:\n"
"      name: \"target_frame\"\n"
"      default: \"turtle1\"\n"
"      description: \"Target frame name.\"\n"
"  - node:\n"
"      pkg: \"learning_tf2_cpp\"\n"
"      exec: \"turtle_tf2_broadcaster\"\n"
"      name: \"broadcaster2\"\n"
"      param:\n"
"      - name: \"turtlename\"\n"
"        value: \"turtle2\"\n"
"  - node:\n"
"      pkg: \"learning_tf2_cpp\"\n"
"      exec: \"turtle_tf2_listener\"\n"
"      name: \"listener\"\n"
"      param:\n"
"      - name: \"target_frame\"\n"
"        value: \"$(var target_frame)\"\n"
